<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">

  <!-- 1-жұмыс: web.xml арқылы тіркеу мысалы (AboutServlet @WebServlet-сіз) -->
  <servlet>
    <servlet-name>about</servlet-name>
    <servlet-class>kz.lab.AboutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>about</servlet-name>
    <url-pattern>/about</url-pattern>
  </servlet-mapping>

  <!-- 13-жұмыс: init-param web.xml арқылы (аннотациядағы мәнді қайта жазады) -->
  <servlet>
    <servlet-name>kz.lab.SiteServlet</servlet-name>
    <servlet-class>kz.lab.SiteServlet</servlet-class>
    <init-param>
      <param-name>siteName</param-name>
      <param-value>Servlet Lab (web.xml)</param-value>
    </init-param>
  </servlet>

  <!-- 14-жұмыс: фильтрлер реті осы жерде анықталады -->
  <filter>
    <filter-name>encoding</filter-name>
    <filter-class>kz.lab.EncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>auth</filter-name>
    <filter-class>kz.lab.AuthFilter</filter-class>
  </filter>
  <filter>
    <filter-name>log</filter-name>
    <filter-class>kz.lab.LogFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>encoding</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>auth</filter-name>
    <url-pattern>/cabinet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>log</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- 8-жұмыс: 404 үшін өз қате бетіміз -->
  <error-page>
    <error-code>404</error-code>
    <location>/error404.html</location>
  </error-page>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
